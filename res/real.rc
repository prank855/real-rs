#include <winres.h>

1 ICON "app.ico"

1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
  FILEVERSION 1,0,0,0
  PRODUCTVERSION 1,0,0,0
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "real-rs audio latency reducer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "real-rs"
            VALUE "LegalCopyright", "Copyright (c) 2026 real-rs contributors"
            VALUE "OriginalFilename", "real-rs.exe"
            VALUE "ProductName", "real-rs"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
